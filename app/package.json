{
  "name": "policy-with-sources",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build:static",
    "dev": "node scripts/preview-static-pages.mjs",
    "prebuild": "node scripts/export-public-topics.mjs",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/build-topic-pages.mjs dist",
    "build:static": "tsc --noEmit && node scripts/export-public-topics.mjs && node scripts/build-static-pages.mjs",
    "pretest": "node scripts/export-public-topics.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "corpus": "node scripts/build-corpus.mjs",
    "prepreview": "npm run build:static",
    "preview": "node scripts/preview-static-pages.mjs",
    "dev:worker": "wrangler dev --local --port 8787",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261106.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "wrangler": "4.158.0"
  }
}
